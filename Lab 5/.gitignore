# Part A: the virtual environment (gigabytes) and Python's cache
.venv/
venv/
__pycache__/

# Part A: YOLO weights and the exported model; yolo export recreates them
*.pt
*.torchscript
*.onnx
*_ncnn_model/

# Part A: yolo predict output (runs/predict, runs/predict2, ...)
runs/

# Part H: the snapshots overnight.py saves. Private, and deleted after the demo anyway.
snaps/

# Scripts started with nohup write their output here
nohup.out

# macOS
.DS_Store

# Yesterday Together: diary runs are the night log the report links to (YOLO runs/ stay ignored)
!/diary/runs/

# Real staged footage: iPhone originals stay local (one is over GitHub's 100 MB limit); diary/real_day keeps 720p H.264 copies
/movies/
# Synthetic clips and their chained segments are regenerated by make_clips.py
/diary/sample_day2/*.mp4
/diary/sample_day2/segments/
